---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지가 존재하지 않습니다.">
  <h1 class="text-3xl font-bold tracking-tight">404</h1>
  <p class="mt-3 text-zinc-600 dark:text-zinc-400">요청한 페이지를 찾을 수 없습니다.</p>
  <p class="mt-6">
    <a href={withBase('/')} class="font-medium hover:underline">홈으로 돌아가기</a>
  </p>
</BaseLayout>
