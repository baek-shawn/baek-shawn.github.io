---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { getPublishedPosts, postUrl } from '../lib/posts';

const posts = await getPublishedPosts();
const postById = new Map(posts.map((post) => [post.id, post]));
---

<BaseLayout title="Projects" description="개인 프로젝트와 관련 글을 소개합니다.">
  <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
  <p class="mt-2 text-zinc-600 dark:text-zinc-400">직접 만들고 운영하는 개인 프로젝트입니다.</p>

  <ul class="mt-6 space-y-6">
    {
      projects.map((project) => {
        const relatedPosts = (project.relatedPosts ?? [])
          .map((id) => postById.get(id))
          .filter((post) => post !== undefined);
        return (
          <li class="rounded-lg border border-zinc-200 p-5 dark:border-zinc-800">
            <h2 class="text-xl font-semibold">{project.name}</h2>
            <p class="mt-2 text-zinc-600 dark:text-zinc-400">{project.description}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {project.tech.map((tech) => (
                <li class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                  {tech}
                </li>
              ))}
            </ul>
            {(project.github || relatedPosts.length > 0) && (
              <div class="mt-4 space-y-1 text-sm">
                {project.github && (
                  <p>
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium hover:underline"
                    >
                      GitHub
                    </a>
                  </p>
                )}
                {relatedPosts.length > 0 && (
                  <div>
                    <p class="font-medium">관련 글</p>
                    <ul class="mt-1 list-inside list-disc text-zinc-600 dark:text-zinc-400">
                      {relatedPosts.map((post) => (
                        <li>
                          <a href={postUrl(post)} class="hover:underline">
                            {post.data.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
