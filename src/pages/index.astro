---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES, CATEGORY_DESCRIPTIONS } from '../consts';
import { getPublishedPosts, categoryUrl } from '../lib/posts';
import { withBase } from '../lib/url';

const recentPosts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{SITE_TITLE}</h1>
    <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{SITE_DESCRIPTION}</p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">카테고리</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        CATEGORIES.map((category) => (
          <li>
            <a
              href={categoryUrl(category)}
              class="block rounded-lg border border-zinc-200 p-4 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900"
            >
              <span class="font-medium">{category}</span>
              <span class="mt-1 block text-sm text-zinc-500 dark:text-zinc-400">
                {CATEGORY_DESCRIPTIONS[category]}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">최근 글</h2>
      <a href={withBase('/blog/')} class="text-sm text-zinc-600 hover:underline dark:text-zinc-400">
        전체 글 보기
      </a>
    </div>
    <div class="mt-2">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
