---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import AdSenseSlot from '../components/AdSenseSlot.astro';
import { postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, publishedAt, updatedAt } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl leading-tight font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{description}</p>
      <div class="mt-4"><PostMeta post={post} showUpdated /></div>
    </header>
    <div class="prose prose-zinc dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>

  {/* AdSense 승인 후 광고 단위 ID를 adSlot에 넣으면 활성화된다. 비어 있으면 표시되지 않는다. */}
  <AdSenseSlot adSlot="" />

  {
    (older || newer) && (
      <nav
        aria-label="이전 글 / 다음 글"
        class="mt-12 grid gap-4 border-t border-zinc-200 pt-6 sm:grid-cols-2 dark:border-zinc-800"
      >
        {older ? (
          <a
            href={postUrl(older)}
            class="rounded-lg border border-zinc-200 p-4 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900"
          >
            <span class="block text-xs text-zinc-500 dark:text-zinc-400">이전 글</span>
            <span class="mt-1 block font-medium">{older.data.title}</span>
          </a>
        ) : (
          <div />
        )}
        {newer && (
          <a
            href={postUrl(newer)}
            class="rounded-lg border border-zinc-200 p-4 text-right hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900"
          >
            <span class="block text-xs text-zinc-500 dark:text-zinc-400">다음 글</span>
            <span class="mt-1 block font-medium">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>
