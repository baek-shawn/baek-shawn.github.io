---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_LANG } from '../consts';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
}

const { title, description, ogType, publishedAt, updatedAt } = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead
      title={title}
      description={description}
      ogType={ogType}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100"
  >
    <Header />
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
