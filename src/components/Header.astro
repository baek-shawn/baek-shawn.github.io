---
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/categories/', label: 'Categories' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  const target = withBase(href);
  return href === '/' ? currentPath === target : currentPath.startsWith(target);
}
---

<header class="border-b border-zinc-200 dark:border-zinc-800">
  <div
    class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-6"
  >
    <a href={withBase('/')} class="text-lg font-bold tracking-tight">{SITE_TITLE}</a>
    <nav aria-label="주요 메뉴">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={withBase(href)}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'hover:text-zinc-900 dark:hover:text-white',
                  isActive(href)
                    ? 'font-semibold text-zinc-900 dark:text-white'
                    : 'text-zinc-600 dark:text-zinc-400',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
