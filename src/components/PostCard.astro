---
import { postUrl, type Post } from '../lib/posts';
import PostMeta from './PostMeta.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="border-b border-zinc-200 py-6 last:border-b-0 dark:border-zinc-800">
  <h2 class="text-xl leading-snug font-semibold">
    <a href={postUrl(post)} class="hover:underline">{post.data.title}</a>
  </h2>
  <p class="mt-2 text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
  <div class="mt-3"><PostMeta post={post} /></div>
</article>
