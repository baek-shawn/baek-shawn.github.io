---
// MDX 글 안에서 주의/참고 문구를 강조할 때 사용한다.
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside
  class="not-prose my-6 rounded-md border-l-4 border-amber-400 bg-amber-50 px-4 py-3 text-sm text-zinc-800 dark:border-amber-500 dark:bg-amber-950/40 dark:text-zinc-200"
>
  {title && <p class="mb-1 font-semibold">{title}</p>}
  <slot />
</aside>
